rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validations

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'valorInvestido', 'valorVenda', 'frete', 'taxas', 'cliente', 'formaPagamento', 'status', 'dataEntrada', 'ownerId'])
        && data.keys().size() <= 15
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.category is string && data.category.size() <= 100
        && data.valorInvestido is number && data.valorInvestido >= 0
        && data.valorVenda is number && data.valorVenda >= 0
        && data.frete is number && data.frete >= 0
        && data.taxas is number && data.taxas >= 0
        && data.cliente is string && data.cliente.size() <= 200
        && data.formaPagamento is string && data.formaPagamento.size() <= 100
        && data.status is string && (data.status == 'Em estoque' || data.status == 'Vendido' || data.status == 'Reservado')
        && data.dataEntrada is string && data.dataEntrada.size() <= 50
        && data.ownerId == request.auth.uid;
    }

    function isValidGoal(data) {
      return data.keys().hasAll(['id', 'title', 'targetAmount', 'achievedAmount', 'deadlineMonth', 'deadlineYear', 'createdAt', 'ownerId'])
        && data.keys().size() <= 9
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.targetAmount is number && data.targetAmount >= 0
        && data.achievedAmount is number && data.achievedAmount >= 0
        && data.deadlineMonth is string && data.deadlineMonth.size() <= 10
        && data.deadlineYear is string && data.deadlineYear.size() <= 10
        && data.createdAt is string && data.createdAt.size() <= 50
        && data.ownerId == request.auth.uid;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'type', 'timestamp', 'read', 'ownerId'])
        && data.keys().size() <= 8
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.message is string && data.message.size() <= 1000
        && data.type is string && (data.type == 'success' || data.type == 'warning' || data.type == 'goal' || data.type == 'info')
        && data.timestamp is string && data.timestamp.size() <= 50
        && data.read is bool
        && data.ownerId == request.auth.uid;
    }

    // Rules for Collections

    match /products/{productId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(request.resource.data);
      allow update: if isOwner(resource.data.ownerId) 
                    && isValidProduct(request.resource.data)
                    && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /goals/{goalId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && isValidId(goalId) && isValidGoal(request.resource.data);
      allow update: if isOwner(resource.data.ownerId) 
                    && isValidGoal(request.resource.data)
                    && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /notifications/{notificationId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isSignedIn() && isValidId(notificationId) && isValidNotification(request.resource.data);
      allow update: if isOwner(resource.data.ownerId) 
                    && isValidNotification(request.resource.data)
                    && request.resource.data.ownerId == resource.data.ownerId;
    }
  }
}
